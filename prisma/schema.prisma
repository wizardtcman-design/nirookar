// اسکیمای پایگاه داده نیروکار — فاز ۲ گام ۱ (نسخه 0.1.1 — بیلد 002)
//
// SQLite برای اجرای محلی/پیش‌نمایش زنده؛ به‌دلیل لایه Repository، تعویض به
// PostgreSQL در آینده فقط با تغییر datasource همین فایل انجام می‌شود و هیچ
// تغییر UI لازم ندارد (اصل وابستگی معکوس).
//
// ⚠️ داده‌های کاربران ثبت‌نام‌شده در این فاز، داده واقعی ورودی مالک برای تست
// پیش‌نمایش زنده است؛ انتشار عمومی و انتقال به سرور عملیاتی نیازمند تأیید است.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * کاربر پلتفرم — نقش‌ها: مشتری/نصاب/فروشگاه + ۵ نقش مدیریتی.
 * نقش‌های مدیریتی فقط با seed سیستم ایجاد می‌شوند و از طریق ثبت‌نام عمومی ساخته نمی‌شوند.
 *
 * فاز ۲ گام ۲ (0.1.2):
 * - passwordHash برای حالت ورود با رمز عبور (سوئیچ otpEnabled خاموش) — scrypt با salt.
 *
 * فاز ۲ گام ۳ (0.1.3) — قانون یکتایی به‌ازای هر نقش (دستور مالک):
 * - یک کد ملی یا شماره موبایل در «هر نقش» فقط یک حساب می‌تواند داشته باشد
 *   (مثلاً دو اکانت نصاب با یک کد ملی ممنوع).
 * - اما همان شخص با همان کد ملی/موبایل می‌تواند در نقش‌های دیگر هم حساب
 *   جداگانه داشته باشد (نصاب + مشتری + فروشگاه = حداکثر ۳ حساب با کد ملی واحد).
 * - قفل یکتایی: ترکیب (phone, role) و (nationalId, role) — نه سراسری.
 * - هشدار ادمین (Audit Log) فقط برای تکرار در «همان نقش» صادر می‌شود.
 * - حساب‌های قدیمی OTP و حساب‌های مدیریتی Sandbox رمز پیش‌فرض 123456 دارند.
 */
model User {
  id           String   @id @default(cuid())
  phone        String
  role         String
  displayName  String
  nationalId   String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile  CustomerProfile?
  installerProfile InstallerProfile?
  shopProfile      ShopProfile?
  sessions         Session[]

  @@unique([phone, role])
  @@unique([nationalId, role])
  @@index([phone])
  @@index([nationalId])
}

/** پروفایل مشتری — حداقل داده؛ عکس اختیاری طبق قانون */
model CustomerProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  city         String
  neighborhood String?
  photoUrl     String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * پرونده کامل نصاب.
 * آدرس محل سکونت «محرمانه» است و فقط در پنل ادمین (با کنترل دسترسی سمت سرور) نمایش داده می‌شود.
 *
 * فاز ۲ گام ۲ (0.1.2): ثبت‌نام اولیه فقط هویت (نام + کد ملی + تخصص + سابقه) است و
 * وضعیت اولیه INCOMPLETE می‌شود؛ مدارک (کد پستی، آدرس، شبا، عکس‌ها) از کارت
 * «تکمیل احراز هویت و مدارک» در پنل شخصی نصاب ارسال و وضعیت به PENDING_VERIFICATION
 * تغییر می‌کند؛ سپس با تأیید حضوری قرارداد و سفته توسط ادمین: ACTIVE.
 * فیلدهای nullable یعنی «هنوز از پنل شخصی ارسال نشده».
 *
 * فاز ۲ گام ۳ (0.1.3): جدول‌های پروفایل به‌ازای هر نقش‌اند؛ nationalId یونیک در
 * همین جدول یعنی «حداکثر یک پرونده نصاب به‌ازای هر کد ملی» — همان شخص می‌تواند
 * در جدول پروفایل نقش‌های دیگر (مشتری/فروشگاه) هم پرونده داشته باشد.
 */
model InstallerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  fullName          String
  nationalId        String    @unique
  city              String
  postalCode        String?
  residenceAddress  String?
  workHistory       String
  specialties       String
  sheba             String?
  photoUrl          String?
  nationalCardUrl   String?
  status            String    @default("INCOMPLETE")
  contractSignedAt  DateTime?
  verifiedByUserId  String?
  verifiedByName    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

/**
 * پرونده فروشگاه/همکار — کد ملی مالک Unique است تا هر فروشگاه فقط یک پروفایل داشته باشد.
 * فاز ۲ گام ۲ (0.1.2): مانند نصاب — ثبت‌نام اولیه (نام فروشگاه + هویت مالک) با وضعیت
 * INCOMPLETE؛ مدارک (کد پستی، آدرس، شبا، لوگو، کارت ملی مالک) از پنل شخصی فروشگاه
 * ارسال می‌شود و وضعیت PENDING_VERIFICATION و سپس ACTIVE (تأیید حضوری ادمین) می‌شود.
 * فاز ۲ گام ۳ (0.1.3): مانند نصاب — یونیک بودن nationalId فقط داخل همین جدول
 * (یکتایی به‌ازای نقش فروشگاه) است و مانع حساب همان شخص در نقش‌های دیگر نیست.
 */
model ShopProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  shopName         String
  ownerName        String
  nationalId       String    @unique
  postalCode       String?
  address          String?
  contactPhone     String
  sheba            String?
  logoUrl          String?
  nationalCardUrl  String?
  status           String    @default("INCOMPLETE")
  contractSignedAt DateTime?
  verifiedByUserId String?
  verifiedByName   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

/** نشست ورود — توکن تصادفی در کوکی httpOnly؛ بدون ذخیره هیچ رمزی */
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  role      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

/**
 * کد تأیید OTP — در این فاز فقط Sandbox با کد ثابت آزمایشی 12345.
 * ساختار عمداً آماده اتصال سرویس پیامک واقعی در فازهای بعد است.
 */
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String   @default("LOGIN")
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([phone, createdAt])
}

/**
 * تنظیمات پویا (قانون «صفر درصد هاردکد») — یک ردیف Singleton.
 * اعداد تجاری به‌صورت JSON ذخیره می‌شوند و ساختار آن‌ها در
 * packages/shared/src/platform-settings.ts تعریف شده است.
 */
model PlatformSettings {
  id        String   @id @default("singleton")
  dataJson  String
  updatedAt DateTime @updatedAt
}

/**
 * Audit Log — سوابق حساس، Append-Only.
 * هیچ مسیر ویرایش یا حذف برای این جدول وجود ندارد (طراحی ضد دستکاری).
 */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
