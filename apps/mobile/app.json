{
  "expo": {
    "name": "نیروکار",
    "slug": "nirookar",
    "version": "0.1.3",
    "orientation": "portrait",
    "scheme": "nirookar",
    "userInterfaceStyle": "light",
    "description": "بازارگاه چندخدمتی خدمات فنی، نصب و فروشگاه‌های مرتبط",
    "ios": {
      "bundleIdentifier": "ir.nirookar.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fa",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "ir.nirookar.app",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-nirookar-release"
    ]
  }
}
